				{
					"listen": "test",
					"script": {
						"exec": [
							"// using chai assertion library to verify the response\r",
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"// Postman Assertion to Deliberately Fail a Test Case\r",
							"\r",
							"pm.test(\"Status code is 404 (deliberate fail)\", function () {\r",
